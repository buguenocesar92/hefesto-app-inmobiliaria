# =============================================================================
# Hefesto Studio — Hefesto Inmobiliaria
# =============================================================================
# Variables de la COMPOSICION (Docker Compose). Las variables de la API estan en
# `api/.env.example`, que es donde vive el resto.
#
# Copie este archivo a `.env` en la raiz de la aplicacion.
# =============================================================================

# Dominio publico de la instalacion. Caddy termina TLS aca.
DOMINIO=inmobiliaria.ejemplo.cl

# Correo para los certificados de Caddy (Let's Encrypt avisa por aca).
ACME_EMAIL=admin@hefesto.cl

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# La usan los servicios de Compose para crear la base y el usuario.
DB_DATABASE=inmobiliaria
DB_USERNAME=inmobiliaria
DB_PASSWORD=cambie-esta-clave

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=inmobiliaria_admin
DB_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# NOTAS
# -----------------------------------------------------------------------------
# - `api/.env` es el archivo que lee Laravel y el que se versiona como
#   `api/.env.example`. Este `.env` solo existe para la composicion.
# - Ninguna de estas claves se versiona con valores reales: `.gitignore` excluye
#   `.env`, `api/.env` y los archivos de secretos.
# - El usuario de la base NO puede ser superusuario ni tener BYPASSRLS. El
#   aislamiento entre inmobiliarias depende de eso, y
#   `inmobiliaria:verificar-aislamiento` falla el despliegue si lo es.
#   Ver docs/03 y docs/07.