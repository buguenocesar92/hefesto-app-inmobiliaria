# =============================================================================
# Hefesto Studio — Hefesto Inmobiliaria: API (Laravel)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

APP_NAME="Hefesto Inmobiliaria"
# `local` en desarrollo, `production` en produccion.
APP_ENV=local
# En produccion tiene que ser `false`: el registro con nivel `debug` puede
# incluir datos de una peticion, y en una inmobiliaria eso incluye clientes y
# operaciones.
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_KEY=
# Generelo con: php artisan key:generate

LOG_CHANNEL=stack
LOG_STACK=single,stderr
# `debug` deja el cuerpo de las peticiones en el registro. Con datos de
# clientes, en produccion tiene que ser `info` o mas alto.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, obligatorio. La Row Level Security no existe en otro motor, y el
# aislamiento entre inmobiliarias depende de ella. Ver docs/03.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=inmobiliaria
DB_USERNAME=inmobiliaria
DB_PASSWORD=cambie-esta-clave

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=inmobiliaria_admin
DB_ADMIN_PASSWORD=

# `prefer` sirve dentro de la red de Compose. Si la base queda afuera de la
# instalacion, use `require` y revise la cadena de conexion. Ver docs/04.
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (cache, sesiones y colas)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Minutos que dura una sesion abierta. Una sesion abierta mucho rato es una
# sesion abierta a la cartera de la inmobiliaria.
SESSION_EXPIRACION_MINUTOS=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Authentik (identidad de Hefesto)
# -----------------------------------------------------------------------------
# URL publica del emisor, SIN barra final. El descubrimiento OIDC se lee de
# `<AUTHENTIK_ISSUER>/.well-known/openid-configuration`.
AUTHENTIK_ISSUER=https://identidad.hefesto.cl
# Cliente OIDC EXCLUSIVO de esta aplicacion: asi se puede revocar el acceso a
# Hefesto Inmobiliaria sin tocar las demas aplicaciones de Hefesto.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de retorno configurada en Authentik.
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# `groups` es lo que permite resolver la inmobiliaria: la pertenencia se
# expresa con EQUIPOS, no por el dominio del correo.
AUTHENTIK_SCOPES="openid profile email groups"
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_CACHE_METADATA=3600
AUTHENTIK_CACHE_JWKS=86400
AUTHENTIK_LEEWAY=60

# -----------------------------------------------------------------------------
# Identidad y reglas del negocio
# -----------------------------------------------------------------------------
# Prefijo de los equipos de Authentik. El equipo de una persona tiene el nombre
# `<prefijo>:<correlacion>:<correo>` y la correlacion debe coincidir con la de la
# tabla `inmobiliarias`. Ver docs/05.
INMOBILIARIA_PREFIJO_EQUIPO=HefestoInmobiliaria

# Dias que puede durar una reserva antes de que se libere sola. Es el tope de
# seguridad: una reserva que espera mas de esto ya no es una reserva.
INMOBILIARIA_RESERVA_DIAS_MAXIMOS=30
# Dias de aviso antes del vencimiento de una reserva.
INMOBILIARIA_RESERVA_DIAS_AVISO=3

# Dias antes del termino en que un arriendo pasa a "por renovar".
INMOBILIARIA_ARRIENDO_DIAS_AVISO=60
INMOBILIARIA_ARRIENDO_MESES_MAXIMOS=60

# Practicas del mercado para precargar el formulario. NO son las reglas de
# calculo: esas viven en App\Services\Operaciones\CalculadoraDeComision y se
# aplican SIEMPRE sobre el valor pactado.
INMOBILIARIA_COMISION_VENTA=3.0
INMOBILIARIA_COMISION_ARRIENDO=4.0

# Desde cuantos dias una reserva se marca como "colgada" en el tablero.
INMOBILIARIA_RESERVA_DIAS_COLGADA=30
INMOBILIARIA_ARRIENDO_DIAS_SIN_RENOVAR=45

# -----------------------------------------------------------------------------
# Almacenamiento de fotos
# -----------------------------------------------------------------------------
# Volumen donde viven las fotos. Las rutas guardadas en la base son SIEMPRE
# relativas a esta raiz.
INMOBILIARIA_FOTOS_RAIZ=/var/www/html/storage/fotos
INMOBILIARIA_FOTOS_TAMANO_MAXIMO_KB=8192