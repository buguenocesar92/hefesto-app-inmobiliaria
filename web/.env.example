# =============================================================================
# Hefesto Inmobiliaria: interfaz (Nuxt)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

# URL interna de la API de Laravel. Solo la usa el servidor de Nuxt: esta
# variable NUNCA viaja al navegador.
#
# En desarrollo, si la API corre fuera de Docker, ajuste el host aca.
NUXT_API_BASE=http://api:8000

# Puerto en que escucha el servidor de Nuxt.
NUXT_PORT=3000

# Cuantas filas trae el tablero de propiedades en curso.
NUXT_FILAS_EN_CURSO=50